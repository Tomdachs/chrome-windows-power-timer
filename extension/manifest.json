{
  "manifest_version": 3,
  "name": "Windows Power Timer",
  "version": "0.1.0",
  "description": "Schedule Windows sleep or shutdown from Chrome in one-minute increments.",
  "key": "",
  "permissions": ["alarms", "storage", "nativeMessaging"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Windows Power Timer",
    "default_popup": "popup.html"
  }
}
